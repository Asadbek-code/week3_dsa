// S2 P4

struct Node{
    int data;
    Node* next;
};

int main(){
    int n;

    cout << "Enter n: ";
    cin >> n;

    //VECTOR
    vector<int> v;

    auto startVectorInsert = high_resolution_clock::now();
    for (int i = 0; i < n; i++){
        v.push_back(i);
    }
    auto stopVectorInsert = high_resolution_clock::now();
    auto vectorInsertTime =
        duration_cast<microseconds>(
            stopVectorInsert - startVectorInsert
        );


    int vectorTarget = n - 1;

    auto startVectorSearch = high_resolution_clock::now();
    for (int i = 0; i < n; i++){
        if (v[i] == vectorTarget)
            break;
    }
    auto stopVectorSearch = high_resolution_clock::now();
    auto vectorSearchTime =
        duration_cast<microseconds>(
            stopVectorSearch - startVectorSearch
        );


    //RAW DYNAMIC ARRAY
    int* A = new int[n];

    auto startArrayInsert = high_resolution_clock::now();
    for (int i = 0; i < n; i++){
        A[i] = i;
    }
    auto stopArrayInsert = high_resolution_clock::now();
    auto arrayInsertTime =
        duration_cast<microseconds>(
            stopArrayInsert - startArrayInsert
        );


    int arrayTarget = n - 1;

    auto startArraySearch = high_resolution_clock::now();
    for (int i = 0; i < n; i++){
        if (A[i] == arrayTarget)
            break;
    }
    auto stopArraySearch = high_resolution_clock::now();
    auto arraySearchTime =
        duration_cast<microseconds>(
            stopArraySearch - startArraySearch
        );


    //LINKED LIST
    Node* head = nullptr;
    Node* tail = nullptr;

    auto startListInsert = high_resolution_clock::now();
    for (int i = 0; i < n; i++){
        Node* newNode = new Node;

        newNode->data = i;
        newNode->next = nullptr;

        if (head == nullptr){
            head = newNode;
            tail = newNode;
        }
        else{
            tail->next = newNode;
            tail = newNode;
        }
    }
    auto stopListInsert = high_resolution_clock::now();
    auto listInsertTime =
        duration_cast<microseconds>(
            stopListInsert - startListInsert
        );

    int listTarget = n - 1;

    auto startListSearch = high_resolution_clock::now();

    Node* current = head;

    while (current != nullptr){
        if (current->data == listTarget)
            break;

        current = current->next;
    }

    auto stopListSearch = high_resolution_clock::now();
    auto listSearchTime =
        duration_cast<microseconds>(
            stopListSearch - startListSearch
        );


    long long vectorBytes =
        v.capacity() * sizeof(int);

    long long arrayBytes =
        n * sizeof(int);

    long long listBytes =
        n * sizeof(Node);


    cout << "n = " << n << endl;

    cout << "\nVector:" << endl;
    cout << "Insert time: "
         << vectorInsertTime.count()
         << " microseconds" << endl;

    cout << "Search time: "
         << vectorSearchTime.count()
         << " microseconds" << endl;

    cout << "Bytes / element: "
         << sizeof(int)
         << endl;

    cout << "Total bytes: "
         << vectorBytes
         << endl;


    cout << "\nRaw Dynamic Array:" << endl;
    cout << "Insert time: "
         << arrayInsertTime.count()
         << " microseconds" << endl;

    cout << "Search time: "
         << arraySearchTime.count()
         << " microseconds" << endl;

    cout << "Bytes / element: "
         << sizeof(int)
         << endl;

    cout << "Total bytes: "
         << arrayBytes
         << endl;


    cout << "\nLinked List:" << endl;
    cout << "Insert time: "
         << listInsertTime.count()
         << " microseconds" << endl;

    cout << "Search time: "
         << listSearchTime.count()
         << " microseconds" << endl;

    cout << "Bytes / element: "
         << sizeof(Node)
         << endl;

    cout << "Total bytes: "
         << listBytes
         << endl;


    cout << "\nNode size: "
         << sizeof(Node)
         << " bytes" << endl;


    delete[] A;

    current = head;

    while (current != nullptr){
        Node* temp = current;
        current = current->next;
        delete temp;
    }

    return 0;
}
